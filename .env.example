# ─── Mapbox (obligatorio en producción) ───────────────────────────────────────
# Un solo token para home y mapa de cobertura. Obtén uno en:
# https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# Alias legacy (opcional si ya usas VITE_MAPBOX_ACCESS_TOKEN en el servidor):
# VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoi...

# ─── API de estaciones Orsan ──────────────────────────────────────────────────
# Desarrollo: http://localhost:8082
# Producción: https://ultragas-api.ers.lat
VITE_API_BASE_URL=https://ultragas-api.ers.lat

# ─── Google Maps (autocompletado en /cobertura) ───────────────────────────────
# https://console.cloud.google.com/ — habilitar Places API y Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=AIza...
