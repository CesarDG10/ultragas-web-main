# Mapbox - mapa decorativo de cobertura en la home
# Obtén tu token en https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.tu_token_aqui

# Mapbox - mapa interactivo real (página /cobertura)
VITE_MAPBOX_TOKEN=pk.tu_token_aqui

# API de estaciones Orsan
# Desarrollo: http://localhost:8082
# Producción: https://ultragas-api.ers.lat
VITE_API_BASE_URL=https://ultragas-api.ers.lat

# Google Maps API - autocompletado de direcciones en el buscador del mapa
# Obtén tu clave en https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=tu_clave_aqui
